# SBH Dev (https://cortex-dev.srbrhospital.com) — clone ข้อมูล + user มาจาก SBH Prod
#
# ไม่ต้องสร้างไฟล์ .env.sbh-dev ก็ได้: ระบบใช้ BASE_URL ด้านล่างเป็นค่าตั้งต้น และยืม user/pass จาก .env.sbh-prod ให้เอง
# สร้างเฉพาะเมื่อต้องการบัญชีต่างจาก Prod — role ที่กรอกในไฟล์นี้ชนะค่าใน .env.sbh-prod
# รูปแบบเดียวกับ .env.example (รหัสผ่านที่มี # หรือช่องว่างให้ครอบด้วย "...")

BASE_URL=https://cortex-dev.srbrhospital.com

CORTEX_USERNAME_Super_User= "user1"
CORTEX_PASSWORD_Super_User=

CORTEX_USERNAME_Doctor= "phy-1"
CORTEX_PASSWORD_Doctor=

CORTEX_USERNAME_Nurse= "x-nurse"
CORTEX_PASSWORD_Nurse=
