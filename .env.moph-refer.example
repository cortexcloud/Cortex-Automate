# ค่าสำหรับยิง Mock Data ไป MOPH Refer UAT — คัดลอกไฟล์นี้เป็น .env.moph-refer แล้วกรอกค่าเอง (.env.moph-refer ไม่ขึ้น git)
# ใช้กับ: npm run mock:refer (mock-data-refer/send-refer.mjs)
# ค่าชุดเดียวกับ Postman collection "Moph-refer-his No provider SSB-uat" (ห้ามใช้ค่าของ collection "…-prd")

# header Client-Id / Client-Secret ของ request "1. Add Refer Data"
MOPH_REFER_CLIENT_ID=
MOPH_REFER_CLIENT_SECRET=

# Bearer Token ของ request เดียวกัน (token คงที่ของ MOPH) — เว้นว่าง = ใช้ token ของ Keycloak (user1) แทน
MOPH_REFER_TOKEN=
