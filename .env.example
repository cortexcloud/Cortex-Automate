# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าเอง (.env ไม่ขึ้น git)
#
# รูปแบบ: ชื่อ=ค่า บรรทัดละตัว
# - user แยกตาม role: CORTEX_USERNAME_<Role> คู่กับ CORTEX_PASSWORD_<Role> (ชื่อ role ต้องตรงกัน)
#   setup เตรียม session เฉพาะ role ใน ROLES_IN_USE (utils/env.ts — ตอนนี้ Super_User) ที่ .auth/<Role>.json
#   เทสที่ใช้ role อื่น: test.use({ storageState: authFile('<Role>') })
# - ถ้ารหัสผ่านมี # หรือช่องว่าง ให้ครอบด้วย "..." (ไม่ครอบ ส่วนหลัง # จะถูกตัดทิ้ง)
# - ห้ามมีชื่อซ้ำ ถ้าซ้ำระบบใช้บรรทัดล่างสุด

BASE_URL=https://dev-x.cortexcloud.co

CORTEX_USERNAME_Super_User=
CORTEX_PASSWORD_Super_User=

CORTEX_USERNAME_Doctor=
CORTEX_PASSWORD_Doctor=

CORTEX_USERNAME_Nurse=
CORTEX_PASSWORD_Nurse=
