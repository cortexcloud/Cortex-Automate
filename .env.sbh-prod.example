# SBH Prod (รพ.สระบุรี) — คัดลอกไฟล์นี้เป็น .env.sbh-prod แล้วกรอกค่าเอง (.env.sbh-prod ไม่ขึ้น git)
# ใช้กับสคริปต์เตรียม Mock Data ใน mock-data/ เท่านั้น: npx playwright test -c playwright.sbh-prod.config.ts
# รูปแบบเดียวกับ .env.example (รหัสผ่านที่มี # หรือช่องว่างให้ครอบด้วย "...")

BASE_URL=https://cortex.srbrhospital.com

CORTEX_USERNAME_Super_User=
CORTEX_PASSWORD_Super_User=

CORTEX_USERNAME_Doctor=
CORTEX_PASSWORD_Doctor=

CORTEX_USERNAME_Nurse=
CORTEX_PASSWORD_Nurse=